Windows Registry Editor Version 5.00

; =========================================================
; .cmd:
; - Keep Open/double-click = execute (cmd.exe /c "%1" %*)
; - Set Edit = Notepad++
; - Optionally add "Edit with Notepad++" too (same as Edit)
; =========================================================

; -----------------------------
; 1) Ensure cmdfile "open" executes
; -----------------------------
[HKEY_CLASSES_ROOT\cmdfile\shell\open\command]
@="\"%SystemRoot%\\System32\\cmd.exe\" /c \"\"%1\" %*\""

; -----------------------------
; 2) Set cmdfile "edit" to Notepad++
;    (This makes right-click -> Edit use Notepad++)
; -----------------------------
[HKEY_CLASSES_ROOT\cmdfile\shell\edit]
@="Edit"
"Icon"="\"C:\\Program Files\\Notepad++\\notepad++.exe\",0"

[HKEY_CLASSES_ROOT\cmdfile\shell\edit\command]
@="\"C:\\Program Files\\Notepad++\\notepad++.exe\" \"%1\""

; -----------------------------
; 3) Optional: add explicit menu item "Edit with Notepad++"
;    (does not affect Open)
; -----------------------------
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.cmd\shell\Edit with Notepad++]
@="Edit with Notepad++"
"Icon"="\"C:\\Program Files\\Notepad++\\notepad++.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.cmd\shell\Edit with Notepad++\command]
@="\"C:\\Program Files\\Notepad++\\notepad++.exe\" \"%1\""
